# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/every_rupee_counts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=every_rupee_counts

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Encryption (server-side sync envelope key derivation salt)
SYNC_ENCRYPTION_SALT=every-rupee-counts-sync-salt

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
